# again, disable builtin rules and variables
MAKEFLAGS += -r -R
FTPKG_GENERATING :=yes

# All packages list of fighters project
FT_PKGS :=
include $(FTPKG_IN)

define FTPKG_FILTER
undefine PKG_NAME
undefine PKG_DEFAULT
include $$(FT_TOPDIR)/$1/ftpkg.mk
$$(eval PKG_ENABLED :=$$$$(CONFIG_$$(PKG_NAME)))
ifeq "$$(PKG_ENABLED)" "y"
  $$(file >> $$(FTPKG_OUT),FT_BPKGS += $1)
else ifneq "$$(PKG_ENABLED)" "n"
  ifeq "$$(PKG_DEFAULT)" "y"
    $$(file >> $$(FTPKG_OUT),FT_BPKGS += $1)
  endif
endif
endef

.PHONY: all clean
all:
	@echo "Packages to be built generated:"
	@exec cat $(FTPKG_OUT)
	@echo "============================================="
clean:
	@rm -f -v $(FTPKG_OUT)
# truncate output file
$(file > $(FTPKG_OUT),# AUTOMATICALLY GENERATED BY FIGHTERS PROJECT)
FT_PKGS :=$(strip $(FT_PKGS))
$(foreach ftpkg,$(FT_PKGS),$(eval $(call FTPKG_FILTER,$(ftpkg))))
